# ---- Gateway ----
PORT=8080
# File JSONL lưu telemetry bền trước ACK; mặc định ./telemetry-spool.jsonl
# TELEMETRY_SPOOL_PATH=/var/lib/petty/telemetry-spool.jsonl

# Bí mật ký JWT. Để trống => chế độ demo, dashboard không cần token.
# Đặt giá trị bất kỳ để bật xác thực RBAC thật (admin / owner / viewer).
JWT_SECRET=

# Token dùng chung cho thiết bị ESP32 (khớp WS_PATH trong firmware/include/config.h)
DEVICE_TOKEN=dev-device-token

# ---- Supabase (tuỳ chọn) ----
# Để trống => chỉ chạy in-memory + dashboard realtime, không ghi cloud.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
