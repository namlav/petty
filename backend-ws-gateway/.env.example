# ---- Gateway ----
PORT=8080
# Local development binds loopback. Set HOST=0.0.0.0 on container hosts (Render/Koyeb).
HOST=
NODE_ENV=development

# Bí mật ký JWT cục bộ (chỉ dùng cho dev/demo khi chưa bật Firebase Auth).
# Để trống trong NODE_ENV=development => chế độ demo (dashboard mặc định admin).
JWT_SECRET=

# Token thiết bị mặc định (dev). Khi lên production, ưu tiên header Authorization
# và collection device_credentials trong Firestore (T-SV2-04).
DEVICE_TOKEN=dev-device-token

# Đường dẫn file spool JSONL cục bộ (SV2: T-SV2-00)
TELEMETRY_SPOOL_PATH=./telemetry-spool.jsonl

# ---- Firebase 100% (Spark Plan - Miễn phí) ----
# Project ID trên Firebase Console (dùng cho Firestore, Firebase Auth, FCM)
FIREBASE_PROJECT_ID=petty-68437

# Đường dẫn file Service Account JSON tải từ Firebase Console -> Project Settings -> Service Accounts.
# Để trống hoặc chưa đặt file => chạy chế độ in-memory + demo (không ghi Cloud).
FIREBASE_SERVICE_ACCOUNT=./secrets/fcm-service-account.json
